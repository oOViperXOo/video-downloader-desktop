{
  "manifest_version": 3,
  "name": "Orvanta Video Downloader Companion",
  "version": "0.1.1",
  "description": "Detects video and audio links on the page and sends them to your Orvanta Video Downloader app on this computer.",
  "minimum_chrome_version": "121",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Orvanta Video Downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/detect.js", "lib/client.js", "background.js"]
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": { "id": "video-downloader-companion@localhost.invalid", "strict_min_version": "128.0" }
  }
}
